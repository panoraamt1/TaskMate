<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TaskMate.ViewModels"
             x:Class="TaskMate.Views.TasksListPage"
             Title="Ülesanded">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Kodu" Order="Primary" Clicked="OnHomeClicked" />
    </ContentPage.ToolbarItems>

    <Grid>
        <CollectionView x:Name="TasksCollection"
                        ItemsSource="{Binding Tasks}"
                        SelectionMode="Single"
                        SelectionChanged="OnTaskSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10">
                        <Frame HasShadow="True" BorderColor="LightGray" Padding="10">
                            <Frame.Triggers>
                                <DataTrigger TargetType="Frame" Binding="{Binding IsDone}" Value="True">
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </Frame.Triggers>

                            <Grid ColumnDefinitions="*, Auto">
                                <HorizontalStackLayout Spacing="15" Grid.Column="0">
                                    <Label Text="⬤" 
                                           TextColor="{Binding PriorityColor}" 
                                           VerticalOptions="Center"/>

                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding Name}" 
                                               FontAttributes="Bold" 
                                               FontSize="16">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    <Setter Property="TextColor" Value="Gray" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <Label Text="{Binding DueDate, StringFormat='{0:dd.MM.yyyy}'}" 
                                               TextColor="Gray" 
                                               FontSize="12"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="5" Grid.Column="1" VerticalOptions="Center">
                                    <Button Text="✓"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:TasksListViewModel}}, Path=MarkDoneCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#2ECC71"
                                            TextColor="White"
                                            WidthRequest="40" HeightRequest="40" CornerRadius="20">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>

                                    <Button Text="✎"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:TasksListViewModel}}, Path=EditCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#3498DB"
                                            TextColor="White"
                                            WidthRequest="40" HeightRequest="40" CornerRadius="20"/>

                                    <Button Text="🗑"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:TasksListViewModel}}, Path=DeleteCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#E74C3C"
                                            TextColor="White"
                                            WidthRequest="40" HeightRequest="40" CornerRadius="20"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="+"
                FontSize="30"
                BackgroundColor="#3498DB"
                TextColor="White"
                HeightRequest="60"
                WidthRequest="60"
                CornerRadius="30"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Clicked="OnAddNewTaskClicked"
                Shadow="{Shadow Brush=Black, Offset='0,5', Opacity='0.3', Radius=5}"/>
    </Grid>
</ContentPage>