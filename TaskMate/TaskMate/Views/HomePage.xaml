<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaskMate.Views.HomePage"
             Title="TaskMate">
    <StackLayout Padding="30" Spacing="20" VerticalOptions="Center">
        <Image Source="taskmate_logo.png" HeightRequest="150"/>
        <Label Text="Tere tulemast TaskMate'i!" FontSize="24" HorizontalOptions="Center"/>

        <Button Text="Lisa ülesanne" Clicked="AddTask_Clicked"/>
        <Button Text="Kõik ülesanded" Clicked="TasksList_Clicked"/>
        <Button Text="Täna" Clicked="TodayTasks_Clicked"/>
    </StackLayout>
</ContentPage>