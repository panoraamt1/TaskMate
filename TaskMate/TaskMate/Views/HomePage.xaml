<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaskMate.Views.HomePage"
             Title="TaskMate">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Image Source="taskmate_logo.png" HeightRequest="120" />
        <Label Text="Tere tulemast TaskMate'i!"
               FontSize="22"
               HorizontalOptions="Center" />

        <Button Text="➕ Lisa ülesanne"
                Clicked="OnAddTaskClicked"/>

        <Button Text="📋 Kõik ülesanded" 
                Clicked="OnTasksClicked"/>
        <Button Text="📅 Täna" 
                Clicked="OnTaskDetailClicked"/>
        <Button Text="⚙️ Seaded" />

    </VerticalStackLayout>
</ContentPage>
