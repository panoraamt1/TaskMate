<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaskMate.Views.TaskDetailPage"
             Title="Ülesande detailid">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="Ülesande olek" HorizontalOptions="Center" FontSize="12" TextColor="Gray"/>
                <Label Text="{Binding StatusText}"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="Green"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="LightGray"/>

            <VerticalStackLayout Spacing="10">
                <Label Text="Pealkiri" FontAttributes="Bold" />
                <Entry Text="{Binding Name, Mode=TwoWay}" />

                <Label Text="Tähtaeg" FontAttributes="Bold" Margin="0,10,0,0"/>
                <DatePicker Date="{Binding DueDate, Mode=TwoWay}" />

                <Label Text="Prioriteet" FontAttributes="Bold" Margin="0,10,0,0"/>
                <HorizontalStackLayout Spacing="10">
                    <Picker Title="Vali tase"
                            ItemsSource="{Binding PriorityOptions}"
                            SelectedItem="{Binding Priority, Mode=TwoWay}"
                            WidthRequest="200" />
                    <Label Text="⬤" 
                           TextColor="{Binding PriorityColor}" 
                           VerticalOptions="Center" 
                           FontSize="20"/>
                </HorizontalStackLayout>

                <Label Text="Kirjeldus" FontAttributes="Bold" Margin="0,10,0,0"/>
                <Editor Text="{Binding Description, Mode=TwoWay}" 
                        AutoSize="TextChanges"
                        MinimumHeightRequest="100" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10" Margin="0,20,0,0">
                <Button Text="{Binding MarkDoneButtonText}" 
                        Command="{Binding MarkDoneCommand}" 
                        BackgroundColor="{Binding MarkDoneButtonColor}" 
                        TextColor="White" />

                <Button Text="Salvesta muudatused" 
                        Command="{Binding SaveCommand}" 
                        BackgroundColor="#3498DB" 
                        TextColor="White" />

                <Button Text="Kustuta ülesanne" 
                        Command="{Binding DeleteCommand}" 
                        BackgroundColor="#E74C3C" 
                        TextColor="White" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>