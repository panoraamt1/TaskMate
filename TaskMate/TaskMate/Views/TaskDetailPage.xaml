<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaskMate.Views.TaskDetailPage"
             Title="Ülesande detailid">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <Label Text="{Binding Name}"
                   FontSize="30"
                   TextColor="Red"
                   HorizontalOptions="Center" />

            <Label Text="{Binding IsDone, StringFormat='Staatus: {0}'}"
                   TextColor="Green"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <BoxView HeightRequest="1" Color="LightGray"/>

            <StackLayout>
                <Label Text="Tähtaeg" FontAttributes="Bold"/>
                <Label Text="{Binding DueDate, StringFormat='{0:dd.MM.yyyy}'}"/>
            </StackLayout>

            <StackLayout>
                <Label Text="Prioriteet" FontAttributes="Bold"/>
                <Label Text="{Binding Priority}"
                       TextColor="{Binding PriorityColor}"/>
            </StackLayout>

            <StackLayout>
                <Label Text="Kirjeldus" FontAttributes="Bold"/>
                <Label Text="{Binding Description}" />
            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>